<Window x:Class="XboxMetroLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:controls="clr-namespace:XboxMetroLauncher.Controls"
        Title="Xbox Metro Launcher"
        Width="1280"
        Height="720"
        MinWidth="1024"
        MinHeight="576"
        Background="{StaticResource DashboardBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        Loaded="Window_OnLoaded"
        Closing="Window_OnClosing">
    <Grid Background="#FF0B0F0B">
    <Grid x:Name="AudioHost"
          Width="1"
          Height="1"
          Opacity="0"
          IsHitTestVisible="False"
          HorizontalAlignment="Left"
          VerticalAlignment="Top" />
    <Viewbox Stretch="Uniform">
    <Grid x:Name="RootGrid" Width="1280" Height="720" ClipToBounds="True" Background="{StaticResource DashboardBackgroundBrush}">
        <Rectangle Opacity="0.08">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.28,0.22" RadiusX="0.85" RadiusY="0.7">
                    <GradientStop Color="#CCFFFFFF" Offset="0" />
                    <GradientStop Color="#66FFFFFF" Offset="0.45" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid
              Visibility="{Binding IsBooting, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="146" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Canvas Margin="0,112,0,0" Height="46" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        IsHitTestVisible="False" Opacity="0.12" Visibility="Collapsed">
                    <TextBlock Canvas.Left="180" Width="58" Height="40" Text="bing" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="262" Width="78" Height="40" Text="home" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="366" Width="86" Height="40" Text="social" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="480" Width="82" Height="40" Text="video" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="602" Width="94" Height="40" Text="games" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="744" Width="88" Height="40" Text="music" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="854" Width="68" Height="40" Text="apps" Style="{StaticResource TabGhostTextStyle}" />
                    <TextBlock Canvas.Left="942" Width="128" Height="40" Text="settings" Style="{StaticResource TabGhostTextStyle}" />
                </Canvas>
                <Canvas Margin="0,96,0,0" Height="46" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Visibility="{Binding IsMyGamesOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button Canvas.Left="180" Canvas.Top="0" Width="58" Height="40" Content="bing" DataContext="{Binding Tabs[0]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="262" Canvas.Top="0" Width="78" Height="40" Content="home" DataContext="{Binding Tabs[1]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="366" Canvas.Top="0" Width="86" Height="40" Content="social" DataContext="{Binding Tabs[2]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="480" Canvas.Top="0" Width="82" Height="40" Content="video" DataContext="{Binding Tabs[3]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="602" Canvas.Top="0" Width="94" Height="40" Content="games" DataContext="{Binding Tabs[4]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="744" Canvas.Top="0" Width="88" Height="40" Content="music" DataContext="{Binding Tabs[5]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="854" Canvas.Top="0" Width="68" Height="40" Content="apps" DataContext="{Binding Tabs[6]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Canvas.Left="942" Canvas.Top="0" Width="128" Height="40" Content="settings" DataContext="{Binding Tabs[7]}"
                            Style="{StaticResource TabButtonStyle}"
                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Canvas>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,72,70,0"
                            Opacity="0.82">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Profile.Gamertag}"
                                   Foreground="#F2FFFFFF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-1,0,0">
                            <TextBlock Text="{Binding Profile.OnlineStatus}" Foreground="#C8FFFFFF" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="24"
                            Height="24"
                            Background="{StaticResource MetroGreenBrush}"
                            ClipToBounds="True">
                        <Image Source="{Binding Profile.GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="ContentFrame"
                  Grid.Row="1"
                  Width="1280"
                  Height="502"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  ClipToBounds="True">
                <Image Width="1280"
                       Height="720"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,-146,0,0"
                       Source="{Binding CurrentReferenceImagePath, Converter={StaticResource StringToImageSourceConverter}}"
                       Stretch="UniformToFill"
                       Opacity="{Binding CurrentReferenceImageOpacity}"
                       IsHitTestVisible="False" />
                <ContentControl x:Name="ContentHost"
                                Width="1280"
                                Height="502"
                                Panel.ZIndex="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Content="{Binding CurrentTab}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentSlide" X="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
                <Canvas x:Name="TabTransitionLayer"
                        Width="1280"
                        Height="502"
                        Panel.ZIndex="60"
                        Visibility="Collapsed"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        Focusable="False">
                    <Canvas x:Name="TabTransitionStrip"
                            Width="3840"
                            Height="502">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="TabTransitionSlide" X="-1280" />
                        </Canvas.RenderTransform>
                        <ContentControl x:Name="TransitionLeftHost"
                                        Width="1280"
                                        Height="502"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        IsHitTestVisible="False"
                                        Focusable="False" />
                        <ContentControl x:Name="TransitionCenterHost"
                                        Width="1280"
                                        Height="502"
                                        Canvas.Left="1280"
                                        Canvas.Top="0"
                                        IsHitTestVisible="False"
                                        Focusable="False" />
                        <ContentControl x:Name="TransitionRightHost"
                                        Width="1280"
                                        Height="502"
                                        Canvas.Left="2560"
                                        Canvas.Top="0"
                                        IsHitTestVisible="False"
                                        Focusable="False" />
                    </Canvas>
                </Canvas>
                <Canvas x:Name="AdjacentPreviewLayer"
                        Width="1280"
                        Height="502"
                        IsHitTestVisible="False"
                        Opacity="0.36"
                        Panel.ZIndex="80"
                        ClipToBounds="True">
                    <Border Canvas.Left="0"
                            Canvas.Top="0"
                            Width="104"
                            Height="502"
                            ClipToBounds="True">
                        <Canvas Width="104"
                                Height="502"
                                ClipToBounds="True">
                            <ContentControl Width="1280"
                                            Height="502"
                                            Canvas.Left="{Binding LeftPreviewContentLeft}"
                                            Canvas.Top="0"
                                            Content="{Binding PreviousTab}"
                                            IsHitTestVisible="False"
                                            Focusable="False">
                                <ContentControl.RenderTransform>
                                    <TranslateTransform x:Name="PreviousPreviewOffset" X="0" />
                                </ContentControl.RenderTransform>
                            </ContentControl>
                        </Canvas>
                    </Border>
                    <Border Canvas.Left="1160"
                            Canvas.Top="0"
                            Width="104"
                            Height="502"
                            ClipToBounds="True">
                        <Canvas Width="104"
                                Height="502"
                                ClipToBounds="True">
                            <ContentControl Width="1280"
                                            Height="502"
                                            Canvas.Left="{Binding RightPreviewContentLeft}"
                                            Canvas.Top="0"
                                            Content="{Binding NextTab}"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            IsHitTestVisible="False"
                                            Focusable="False">
                                <ContentControl.RenderTransform>
                                    <TranslateTransform x:Name="NextPreviewOffset" X="0" />
                                </ContentControl.RenderTransform>
                            </ContentControl>
                        </Canvas>
                    </Border>
                </Canvas>

                <Canvas x:Name="DebugGuides" Width="1280" Height="502" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle Width="1280" Height="502" Stroke="#99FF00FF" StrokeThickness="2" />
                    <Line X1="0" Y1="0" X2="1280" Y2="0" Stroke="#99FFFF00" StrokeThickness="1" />
                    <Line X1="198" Y1="0" X2="198" Y2="502" Stroke="#9900FFFF" StrokeThickness="1" />
                    <Line X1="0" Y1="74" X2="1280" Y2="74" Stroke="#9900FFFF" StrokeThickness="1" />
                </Canvas>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="112,16,0,0">
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FF6CB344">
                        <TextBlock Text="A" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text=" Select   " Foreground="#FF5A5F61" FontSize="16" />
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFE0C33C">
                        <TextBlock Text="Y" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text=" Eject" Foreground="#FF5A5F61" FontSize="16" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Width="408" HorizontalAlignment="Right" Background="#E8121516"
                BorderBrush="#66FFFFFF" BorderThickness="1,0,0,0" Padding="28"
                Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="details" Foreground="#AAFFFFFF" FontSize="18" />
                <TextBlock Text="{Binding SelectedGame.Title}" Foreground="White" FontSize="36" FontWeight="Light" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedGame.Subtitle}" Style="{StaticResource MutedText}" Margin="0,8,0,24" />
                <TextBlock Text="Executable" Foreground="#AAFFFFFF" FontSize="14" />
                <TextBlock Text="{Binding SelectedGame.Game.ExecutablePath}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20" />
                <TextBlock Text="Last played" Foreground="#AAFFFFFF" FontSize="14" />
                <TextBlock Text="{Binding SelectedGame.Game.LastPlayed}" Foreground="White" FontSize="14" Margin="0,0,0,24" />
                <Button Content="Launch" Style="{StaticResource MetroActionButtonStyle}"
                        Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}" />
                <Button Content="Pin / Unpin" Style="{StaticResource MetroActionButtonStyle}"
                        Margin="0,10,0,0" Command="{Binding ToggleFavoriteCommand}" />
                <Button Content="Change executable" Style="{StaticResource MetroActionButtonStyle}"
                        Margin="0,10,0,0" Command="{Binding EditSelectedGameCommand}" />
            </StackPanel>
        </Border>

        <Grid Background="#B0000000"
              Visibility="{Binding IsSearchOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F0F4F6F4" BorderBrush="White" BorderThickness="2"
                    CornerRadius="2" Padding="28">
                <StackPanel>
                    <TextBlock Text="Bing" Foreground="#FF1A1C1B" FontSize="42" FontWeight="Light" />
                    <TextBlock Text="Search games, help, stores, and the web." Foreground="#FF4D5650" FontSize="17" Margin="0,0,0,18" />
                    <TextBox x:Name="SearchOverlayTextBox" Style="{StaticResource MetroTextBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Search" Style="{StaticResource MetroActionButtonStyle}" Command="{Binding SubmitSearchCommand}" />
                        <Button Content="Cancel" Margin="12,0,0,0" Style="{StaticResource MetroActionButtonStyle}" Command="{Binding CloseSearchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Width="360" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="70,0,0,0"
                Background="#ED101314" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="24"
                Visibility="{Binding IsQuickMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="quick menu" Foreground="#AAFFFFFF" FontSize="18" />
                <TextBlock Text="Options" Foreground="White" FontSize="38" FontWeight="Light" Margin="0,0,0,18" />
                <Button Content="Add game" Style="{StaticResource MetroActionButtonStyle}" Command="{Binding AddGameCommand}" />
                <Button Content="Scan folder" Style="{StaticResource MetroActionButtonStyle}" Margin="0,10,0,0" Command="{Binding ScanFolderCommand}" />
                <Button Content="Settings" Style="{StaticResource MetroActionButtonStyle}" Margin="0,10,0,0"
                        Command="{Binding OpenLauncherSettingsCommand}" />
            </StackPanel>
        </Border>

        <Grid x:Name="MyGamesOverlay"
              Background="#FFAEB6B5"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsMyGamesOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Rectangle Opacity="0.26" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF303637" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                        <GradientStop Color="#FFD9DDDC" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Orientation="Horizontal" Margin="80,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Width="170">
                    <TextBlock Text="⌄ show me" Foreground="#F2FFFFFF" FontSize="18" />
                    <TextBlock Text="{Binding LibraryMenuFilterText}" Foreground="#D8FFFFFF" FontSize="21" FontWeight="Light" />
                </StackPanel>
                <StackPanel Width="170" Margin="36,0,0,0">
                    <TextBlock Text="⌄ sort" Foreground="#F2FFFFFF" FontSize="18" />
                    <TextBlock Text="titles" Foreground="#D8FFFFFF" FontSize="21" FontWeight="Light" />
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,78,0">
                <TextBlock Text="{Binding LibraryMenuTitle}" Foreground="White" FontSize="30" FontWeight="Light" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding LibraryMenuCountText}" Foreground="#E8FFFFFF" FontSize="18" HorizontalAlignment="Right" />
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="75,134,0,0" Height="348" Focusable="False">
                <Grid>
                    <ItemsControl ItemsSource="{Binding BlankGameSlots}"
                                  Focusable="False"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="188" Height="327" Background="#F4F4F4" Margin="0,0,8,0">
                                    <Grid>
                                        <Border Height="264" VerticalAlignment="Top" Background="#FF999999" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LibraryMenuGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="188" Height="327" Margin="0,0,8,0"
                                        Style="{StaticResource X360TileButtonStyle}"
                                        Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid Background="#F4F4F4">
                                        <Border Width="188" Height="264" VerticalAlignment="Top" ClipToBounds="True"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                SnapsToDevicePixels="True">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource GameCoverBrushConverter}">
                                                    <Binding Path="CoverArtPath" />
                                                    <Binding Path="DataContext.GameCoverFitMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="CoverZoom" />
                                                    <Binding Path="CoverOffsetX" />
                                                    <Binding Path="CoverOffsetY" />
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                        <Rectangle Height="63" VerticalAlignment="Bottom" Fill="#F4F4F4" />
                                        <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,7">
                                            <TextBlock Text="{Binding Title}" Foreground="#FF555555" FontSize="17" TextWrapping="Wrap" LineHeight="18" MaxHeight="38" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#FF777777" FontSize="15" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="75,0,0,34">
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF6CB344"><TextBlock Text="A" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Launch   " Foreground="#FF5A5F61" FontSize="16" />
                <Border Width="20" Height="20" CornerRadius="10" Background="#FFD73A3A"><TextBlock Text="B" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Back   " Foreground="#FF5A5F61" FontSize="16" />
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF277DB8"><TextBlock Text="X" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="{Binding LibraryMenuXHintText}" Foreground="#FF5A5F61" FontSize="16" />
            </StackPanel>
        </Grid>

        <Grid x:Name="LauncherSettingsOverlay"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsLauncherSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <Style x:Key="SettingsFocusVisual">
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border Margin="-4"
                                        BorderBrush="White"
                                        BorderThickness="2"
                                        CornerRadius="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Color="#FF79D544"
                                                          Opacity="0.75" />
                                    </Border.Effect>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="SettingsActionButtonStyle"
                       TargetType="{x:Type Button}"
                       BasedOn="{StaticResource MetroActionButtonStyle}">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
                    <Setter Property="BorderBrush" Value="#88FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="#FF008A00" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="White" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="{x:Type ComboBox}">
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
                    <Setter Property="BorderBrush" Value="#66999999" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="#FF008A00" />
                            <Setter Property="BorderThickness" Value="3" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Foreground" Value="#FF1D1D1D" />
                    <Setter Property="Background" Value="#EEFFFFFF" />
                    <Setter Property="BorderBrush" Value="#88999999" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="CaretBrush" Value="{StaticResource MetroGreenBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="#FF008A00" />
                            <Setter Property="BorderThickness" Value="3" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="SettingsCheckBoxStyle" TargetType="{x:Type CheckBox}">
                    <Setter Property="Foreground" Value="#FF333333" />
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="Margin" Value="30,6,0,0" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Foreground" Value="#FF008A00" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="{x:Type Slider}">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Foreground" Value="#FF008A00" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF171126" Offset="0" />
                    <GradientStop Color="#FF5F355F" Offset="0.6" />
                    <GradientStop Color="#FFB9783D" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock Text="Display" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="62,62,0,0" />
            <Grid Width="884" Height="482" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="442" />
                    <ColumnDefinition Width="442" />
                </Grid.ColumnDefinitions>
                <Border Background="#EEF3F5F5" />
                <Border Grid.Column="1" Background="#D9AEB3B6" />
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              PanningMode="VerticalOnly">
                    <StackPanel KeyboardNavigation.DirectionalNavigation="Continue">
                        <Border Height="48" Background="#F8FFFFFF"><TextBlock Text="HDTV Settings" Foreground="#FF333333" FontSize="24" Margin="30,0,0,0" VerticalAlignment="Center" /></Border>
                        <Border Height="48" Background="#FF008A00"><TextBlock Text="Resolution" Foreground="White" FontSize="24" Margin="30,0,0,0" VerticalAlignment="Center" /></Border>
                        <ComboBox Height="42" Margin="30,8,30,6" ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding Settings.DisplayResolution, Mode=TwoWay}" />
                        <TextBlock Text="Add items to" Foreground="#FF333333" FontSize="18" Margin="30,6,30,0" />
                        <ComboBox Height="42"
                                  Margin="30,4,30,6"
                                  ItemsSource="{Binding AddDestinationOptions}"
                                  SelectedItem="{Binding DefaultAddDestination, Mode=TwoWay}" />
                        <TextBlock Text="Game to edit" Foreground="#FF333333" FontSize="18" Margin="30,6,30,0" />
                        <ComboBox Height="42"
                                  Margin="30,4,30,6"
                                  ItemsSource="{Binding Games}"
                                  SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  DisplayMemberPath="Title" />
                        <Button Content="Add Executable" Style="{StaticResource SettingsActionButtonStyle}" Margin="30,6,30,0" Command="{Binding AddGameCommand}" />
                        <Button Content="Edit Executable" Style="{StaticResource SettingsActionButtonStyle}" Margin="30,6,30,0" Command="{Binding EditSelectedGameCommand}" />
                        <Button Content="Choose Home Screen Image" Style="{StaticResource SettingsActionButtonStyle}" Margin="30,6,30,0" Command="{Binding ChooseSelectedHomeImageCommand}" />
                        <Button Content="Choose My Games/Apps Image" Style="{StaticResource SettingsActionButtonStyle}" Margin="30,6,30,0" Command="{Binding ChooseSelectedGameMenuImageCommand}" />
                        <TextBlock Text="My Games cover fit" Foreground="#FF333333" FontSize="16" Margin="30,6,30,0" />
                        <ComboBox Height="36" Margin="30,6,30,0" ItemsSource="{Binding GameCoverFitOptions}" SelectedItem="{Binding GameCoverFitMode, Mode=TwoWay}" />
                        <TextBlock Text="Cover preview editor" Foreground="#FF333333" FontSize="16" Margin="30,12,30,0" />
                        <Grid Margin="30,6,30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="94" Height="132" ClipToBounds="True" HorizontalAlignment="Left">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource GameCoverBrushConverter}">
                                        <Binding Path="SelectedGame.CoverArtPath" />
                                        <Binding Path="GameCoverFitMode" />
                                        <Binding Path="SelectedCoverZoom" />
                                        <Binding Path="SelectedCoverOffsetX" />
                                        <Binding Path="SelectedCoverOffsetY" />
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Zoom" Foreground="#FF333333" FontSize="14" />
                                <Slider Minimum="1" Maximum="1.8" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.05"
                                        Value="{Binding SelectedCoverZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Move left / right" Foreground="#FF333333" FontSize="14" Margin="0,4,0,0" />
                                <Slider Minimum="-1" Maximum="1" TickFrequency="0.1" SmallChange="0.02" LargeChange="0.1"
                                        Value="{Binding SelectedCoverOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Move up / down" Foreground="#FF333333" FontSize="14" Margin="0,4,0,0" />
                                <Slider Minimum="-1" Maximum="1" TickFrequency="0.1" SmallChange="0.02" LargeChange="0.1"
                                        Value="{Binding SelectedCoverOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Show On Open Tray" Style="{StaticResource SettingsActionButtonStyle}" Margin="30,6,30,0" Command="{Binding SetOpenTrayGameCommand}" />
                        <Button Content="Remove" Style="{StaticResource SettingsActionButtonStyle}" Margin="30,6,30,0" Command="{Binding RemoveSelectedGameCommand}" />
                        <CheckBox Content="Start fullscreen" IsChecked="{Binding Settings.StartFullscreen}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="30,12,0,0" />
                        <CheckBox Content="Play UI sounds" IsChecked="{Binding Settings.PlayUiSounds}" Style="{StaticResource SettingsCheckBoxStyle}" />
                        <CheckBox Content="Enable controller input" IsChecked="{Binding Settings.EnableControllerInput}" Style="{StaticResource SettingsCheckBoxStyle}" />
                        <CheckBox Content="Launch on Windows startup" IsChecked="{Binding Settings.LaunchOnWindowsStartup}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="30,6,0,18" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Margin="30,26,30,0">
                    <TextBlock Text="Current Setting" Foreground="White" FontSize="28" />
                    <TextBlock Text="{Binding Settings.DisplayResolution}" Foreground="White" FontSize="24" Margin="92,18,0,0" />
                    <TextBlock Text="Widescreen" Foreground="White" FontSize="24" Margin="92,0,0,0" />
                    <TextBlock Text="HDMI" Foreground="White" FontSize="24" Margin="92,0,0,28" />
                    <TextBlock Text="Selected game" Foreground="#E8FFFFFF" FontSize="18" />
                    <TextBox Text="{Binding SelectedGame.Game.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,10" />
                    <Button Content="Save Name" Style="{StaticResource SettingsActionButtonStyle}" Command="{Binding SaveSelectedGameCommand}" />
                    <TextBlock Text="Game cover fit" Foreground="#E8FFFFFF" FontSize="18" Margin="0,22,0,6" />
                    <TextBlock Text="{Binding GameCoverFitMode, StringFormat=Fill zooms and crops art to remove side gaps; current mode: {0}}" Foreground="#D8FFFFFF" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="Select an added game, then edit its name, executable, Home screen image, My Games image, or set it as the Open Tray launch tile."
                               Foreground="#D8FFFFFF" FontSize="18" TextWrapping="Wrap" Margin="0,28,0,0" />
                    <Button Content="Save Settings" Style="{StaticResource SettingsActionButtonStyle}" Margin="0,34,0,0" Command="{Binding SaveSettingsCommand}" />
                    <Button Content="Back" Style="{StaticResource SettingsActionButtonStyle}" Margin="0,10,0,0" Command="{Binding CloseLauncherSettingsCommand}" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45">
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF6CB344"><TextBlock Text="A" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Select   " Foreground="White" FontSize="16" />
                <Border Width="20" Height="20" CornerRadius="10" Background="#FFD73A3A"><TextBlock Text="B" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Back" Foreground="White" FontSize="16" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MusicPlayerOverlay"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsMusicPlayerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <Style x:Key="MusicPlayerButtonStyle" TargetType="{x:Type Button}">
                    <Setter Property="Foreground" Value="#FF333333" />
                    <Setter Property="Background" Value="#FFE8ECEC" />
                    <Setter Property="BorderBrush" Value="#55FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="FontSize" Value="17" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="#FF5EAE19" />
                                        <Setter Property="BorderBrush" Value="White" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Root" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="White" Opacity="0.35" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF3F8610" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="MusicTrackButtonStyle" TargetType="{x:Type Button}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid>
                                    <ContentPresenter />
                                    <Border x:Name="FocusFrame"
                                            BorderBrush="#FF5EAE19"
                                            BorderThickness="4"
                                            Opacity="0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                                        <Setter Property="Panel.ZIndex" Value="10" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Opacity" Value="0.82" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F0060708" Offset="0" />
                                <GradientStop Color="#EA161A1C" Offset="0.55" />
                                <GradientStop Color="#F0020203" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMusicPlayerTransparent}" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMusicVisualizerFullscreen}" Value="True">
                            <Setter Property="Background" Value="#F4000000" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Text="Now Playing" Foreground="#F2FFFFFF" FontSize="32" FontWeight="Light" Margin="148,52,0,0">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMusicVisualizerFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid x:Name="MusicPlayerContentGrid" Width="880" Height="482" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMusicVisualizerFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <Border Background="#EEF0F2F1" />
                <Border Grid.Column="1" Background="#D9AEB4B7" />

                <StackPanel Margin="26,18,26,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="58" Height="38" Content="{Binding MusicPlayPauseText}" Background="#FF5EAE19" Foreground="White"
                                Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding PlayPauseMusicCommand}" />
                        <Button Width="58" Height="38" Content="Prev" Margin="5,0,0,0" Foreground="#FF333333" Background="#FFE8ECEC"
                                Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding PreviousMusicCommand}" />
                        <Button Width="58" Height="38" Content="Stop" Margin="5,0,0,0" Foreground="#FF333333" Background="#FFE8ECEC"
                                Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding StopMusicCommand}" />
                        <Button Width="58" Height="38" Content="Next" Margin="5,0,0,0" Foreground="#FF333333" Background="#FFE8ECEC"
                                Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding NextMusicCommand}" />
                        <Button Width="82" Height="38" Content="{Binding ShuffleText}" Margin="5,0,0,0" Foreground="#FF333333" Background="#FFE8ECEC"
                                Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding ToggleShuffleMusicCommand}" />
                    </StackPanel>

                    <TextBlock Text="Edit or Save Playlist" Foreground="#FF55595C" FontSize="22" Margin="0,20,0,14" />
                    <TextBlock Text="{Binding CurrentMusicTitle}" Foreground="#FF55595C" FontSize="21" TextTrimming="CharacterEllipsis" Margin="0,22,0,8" />
                    <Grid Height="44">
                        <Border Height="8" Background="#FFB5BABB" VerticalAlignment="Top" Margin="0,8,0,0" />
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding MusicProgress}" Foreground="#FF6D7173" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding MusicPositionText}" Foreground="#FF55595C" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding MusicDurationText}" Foreground="#FF55595C" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="128" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="96" />
                        </Grid.RowDefinitions>

                        <Border ClipToBounds="True">
                            <controls:MusicVisualizer IsActive="{Binding IsMusicPlaying}"
                                                      Volume="{Binding MusicVolume}"
                                                      Progress="{Binding MusicProgress}"
                                                      Bass="{Binding VisualizerBass}"
                                                      Mid="{Binding VisualizerMid}"
                                                      Treble="{Binding VisualizerTreble}"
                                                      Loudness="{Binding VisualizerLoudness}"
                                                      Peak="{Binding VisualizerPeak}" />
                        </Border>

                        <Border Grid.Row="2" Background="#FFE2E5E4">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Music Files" Foreground="#FF6B7174" FontSize="22" FontWeight="Light" HorizontalAlignment="Center" />
                                <TextBlock Text="Assets\Custom Files\Music Files" Foreground="#FF7D8385" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding MusicVolumeText, StringFormat=Volume {0}}" Foreground="#FF7D8385" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Width="68" Height="28" Content="Vol -" Foreground="#FF333333" Background="#FFE8ECEC"
                                            Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding VolumeDownCommand}" />
                                    <Button Width="68" Height="28" Content="Vol +" Margin="8,0,0,0" Foreground="#FF333333" Background="#FFE8ECEC"
                                            Style="{StaticResource MusicPlayerButtonStyle}" Command="{Binding VolumeUpCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MusicTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="48"
                                            Style="{StaticResource MusicTrackButtonStyle}"
                                            Command="{Binding DataContext.PlaySelectedMusicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid Background="#21FFFFFF">
                                            <TextBlock Text="{Binding Title}" Foreground="#FF5F6669" FontSize="21" Margin="30,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="playing" Foreground="#FF5EAE19" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding MusicTrackCountText}" Foreground="#FF5F6669" FontSize="15" VerticalAlignment="Bottom" Margin="30,0,0,24" />
                </Grid>
            </Grid>

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Visibility="{Binding IsMusicVisualizerFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:MusicVisualizer IsActive="{Binding IsMusicPlaying}"
                                          Volume="{Binding MusicVolume}"
                                          Progress="{Binding MusicProgress}"
                                          Bass="{Binding VisualizerBass}"
                                          Mid="{Binding VisualizerMid}"
                                          Treble="{Binding VisualizerTreble}"
                                          Loudness="{Binding VisualizerLoudness}"
                                          Peak="{Binding VisualizerPeak}" />
            </Grid>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="145,0,0,58">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMusicVisualizerFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF6CB344"><TextBlock Text="A" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Select   " Foreground="#E6FFFFFF" FontSize="16" />
                <Border Width="20" Height="20" CornerRadius="10" Background="#FFD73A3A"><TextBlock Text="B" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Back   " Foreground="#E6FFFFFF" FontSize="16" />
                <Grid Background="Transparent"
                      Cursor="Hand"
                      Margin="0"
                      MouseLeftButtonUp="MusicFullscreenHint_OnMouseLeftButtonUp">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#FF2574AA"><TextBlock Text="X" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text=" Fullscreen Visualizer" Foreground="#E6FFFFFF" FontSize="16" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid x:Name="ProfileEditorOverlay"
              Visibility="{Binding IsProfileEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E9000000" Offset="0" />
                    <GradientStop Color="#D20B0E0F" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock Text="Profile" Foreground="White" FontSize="18" Margin="138,38,0,0" />
            <TextBlock Text="{Binding ClockText}" Foreground="#E8FFFFFF" FontSize="18" HorizontalAlignment="Right" Margin="0,36,138,0" VerticalAlignment="Top" />
            <Grid Width="760" Height="402" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>
                <Border Background="#EEF4F6F5" />
                <Border Grid.Column="1" Background="#D35D686D" />
                <StackPanel>
                    <Border Height="36" Background="#F8FFFFFF">
                        <TextBlock Text="View Games" Foreground="#FF222222" FontSize="17" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="36" Background="#FF008A00">
                        <TextBlock Text="Edit Profile" Foreground="White" FontSize="17" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="36" Background="#F8FFFFFF">
                        <TextBlock Text="View Rep" Foreground="#FF222222" FontSize="17" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="36" Background="#F8FFFFFF">
                        <TextBlock Text="Game Defaults" Foreground="#FF222222" FontSize="17" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="36" Background="#F8FFFFFF">
                        <TextBlock Text="Sign-in Preferences" Foreground="#FF222222" FontSize="17" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="36" Background="#F8FFFFFF">
                        <TextBlock Text="Account Security" Foreground="#FF222222" FontSize="17" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Border Height="72" VerticalAlignment="Top" Background="#F8FFFFFF" Margin="10,10,10,0">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button Width="52" Height="52"
                                    Style="{StaticResource X360TileButtonStyle}"
                                    Command="{Binding ChooseProfilePictureCommand}"
                                    ToolTip="Change gamer picture">
                                <Image Source="{Binding Profile.GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Button>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profile.Gamertag}" Foreground="#FF1F1F1F" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Profile.OnlineStatus}" Foreground="#FF555555" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="28,98,28,0">
                        <TextBlock Text="Username" Foreground="White" FontSize="16" />
                        <TextBox Text="{Binding Profile.Gamertag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetroTextBoxStyle}" Margin="0,5,0,12" />
                        <TextBlock Text="Motto" Foreground="White" FontSize="16" />
                        <TextBox Text="{Binding Profile.Motto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetroTextBoxStyle}" Margin="0,5,0,12" />
                        <TextBlock Text="Description" Foreground="White" FontSize="16" />
                        <TextBox Text="{Binding Profile.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetroTextBoxStyle}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Change Picture" Width="148" Style="{StaticResource MetroActionButtonStyle}" Command="{Binding ChooseProfilePictureCommand}" />
                            <Button Content="Save" Width="112" Margin="10,0,0,0" Style="{StaticResource MetroActionButtonStyle}" Command="{Binding SaveProfileCommand}" />
                            <Button Content="Back" Width="112" Margin="10,0,0,0" Style="{StaticResource MetroActionButtonStyle}" Command="{Binding CloseProfileEditorCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="138,0,0,38">
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF6CB344"><TextBlock Text="A" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Select   " Foreground="White" FontSize="16" />
                <Border Width="20" Height="20" CornerRadius="10" Background="#FFD73A3A"><TextBlock Text="B" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text=" Back" Foreground="White" FontSize="16" />
            </StackPanel>
        </Grid>

    </Grid>
    </Viewbox>

    <Grid x:Name="BootOverlay" Background="White"
          Visibility="{Binding IsBooting, Converter={StaticResource BooleanToVisibilityConverter}}">
        <wfi:WindowsFormsHost x:Name="BootVideoHost" />
        <Viewbox Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed">
            <Canvas Width="1280" Height="720">
                <TextBlock Canvas.Left="902"
                           Canvas.Top="430"
                           Text="®"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           Foreground="#FF9C9C9C"
                           Opacity="0.85" />
            </Canvas>
        </Viewbox>
    </Grid>
    </Grid>
</Window>
