                                            MouseLeftButtonUp="FriendProfileActions_OnMouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="16,0,10,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Border Grid.Column="1"
                                        Background="#D0ABB2B6"
                                        BorderBrush="#FFC2C9CC"
                                        BorderThickness="1,0,0,0">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#FF74818A" BorderBrush="#FFC2C9CC" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Personal Profile"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                        <Grid Grid.Row="1" Margin="14,12,14,12">
                                            <Grid.RowDefinitions>
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="102" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Background="#B7BBBE" BorderBrush="#D8E4E7E8" BorderThickness="1">
                                            <TextBlock Text="{Binding ActiveFriendGamertag}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="16.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF34383A" />
                                        </Border>

                                        <Border Grid.Row="1" Background="#FFF6F5F6" BorderBrush="#CCD1D7DA" BorderThickness="1,0,1,1">
                                            <Grid Margin="8,8,8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="70" Height="70" Background="#FFBEC5C9" BorderBrush="#FF98A2A8" BorderThickness="1">
                                                    <Image Source="{Binding ActiveFriendPicturePath, Converter={StaticResource StringToImageSourceConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,2,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Rep" Foreground="#FF424A4F" FontSize="14" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ActiveFriendReputation}" Foreground="#FFE17E26" FontSize="20" />
                                                    </Grid>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Gamerscore" Foreground="#FF424A4F" FontSize="14" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ActiveFriendGamerscore}" Foreground="#FF34383A" FontSize="14" />
                                                    </Grid>
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Zone" Foreground="#FF424A4F" FontSize="14" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ActiveFriendZone}" Foreground="#FF34383A" FontSize="14" />
                                                    </Grid>
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Link" Foreground="#FF424A4F" FontSize="13" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ActiveFriendSourceLabel}"
                                                                   Foreground="#FF5A6267"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Background="#C69CA4A8" BorderBrush="#CCD1D7DA" BorderThickness="1,0,1,1">
                                            <Grid Margin="12,10,12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding ActiveFriendCountry}"
                                                           FontSize="15"
                                                           Foreground="White" />

                                                <Border Grid.Row="1"
                                                        Width="56"
                                                        Height="56"
                                                        Margin="0,14,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#EEF7F8F8"
                                                        BorderBrush="#66FFFFFF"
                                                        BorderThickness="1" />

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding ActiveFriendStatus}"
                                                           FontSize="15"
                                                           Foreground="#FFF4F6F7"
                                                           VerticalAlignment="Bottom" />

                                                <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,2,2">
                                                    <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" Foreground="#79F2F5F6" FontSize="18" Margin="0,0,10,0" />
                                                    <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" Foreground="#79F2F5F6" FontSize="18" Margin="0,0,10,0" />
                                                    <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" Foreground="#79F2F5F6" FontSize="18" Margin="0,0,10,0" />
                                                    <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" Foreground="#79F2F5F6" FontSize="18" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                    <ContentControl Grid.Row="1" Style="{StaticResource GuideOverlayFooterStyle}" />
            </Grid>

                <Grid Canvas.Left="404"
                      Canvas.Top="244"
                      Width="472"
                      Height="156"
                      Visibility="{Binding IsSocialMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#FF15191B"
                            BorderBrush="#FF5B6368"
                            BorderThickness="1,1,1,0"
                            Height="40"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding SocialMessageTitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="18" />
                    </Border>
                    <Border Margin="0,40,0,0"
                            Background="#FFE8ECEE"
                            BorderBrush="#FF98A2A8"
                            BorderThickness="1">
                        <TextBlock Text="{Binding SocialMessageText}"
                                   Margin="24,0,24,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#FF333638"
                                   FontSize="20" />
                    </Border>
                </Grid>

                <TextBlock Text="{Binding StatusText}"
                           Canvas.Left="477"
                           Canvas.Top="614"
                           Foreground="#CCFFFFFF"
                           FontSize="15"
                           Visibility="{Binding ShowStatusText, Converter={StaticResource BooleanToVisibilityConverter}}" />

            </Canvas>
        </Viewbox>
    </Grid>
</Window>
