<Window x:Class="XboxMetroLauncher.Views.BladesGuideWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:XboxMetroLauncher.Controls"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" Title="Xbox Guide" FontFamily="Convection, Segoe UI" FontSize="23"
 PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <Style x:Key="GuideRow" TargetType="Button">
   <Setter Property="Foreground" Value="#FF2C2C20"/><Setter Property="Background" Value="#08FFFFFF"/>
   <Setter Property="BorderBrush" Value="#40837628"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="8,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Plate" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFF7F8CE" Offset="0"/><GradientStop Color="#B5FFFFD7" Offset="0.45"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter TargetName="Plate" Property="BorderBrush" Value="#FFBBED6C"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#90FFFFDE"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="#B0C4E680"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GuideTool" TargetType="Button" BasedOn="{StaticResource GuideRow}">
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#908F842F"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFE8" Offset="0"/><GradientStop Color="#12FFFFE8" Offset="0.55"/><GradientStop Color="#409D8823" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Height" Value="34"/>
   <Setter Property="FontSize" Value="21"/><Setter Property="Padding" Value="1"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Border x:Name="Dimmer" Background="#B8000000" Opacity="0"/>
  <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
   <Canvas Width="1280" Height="720" ClipToBounds="True">
    <Grid x:Name="Shell" Width="560" Height="720">
     <Grid.RenderTransform><TranslateTransform x:Name="Slide" X="-560"/></Grid.RenderTransform>
     <controls:BladesGuideChrome/>
     <TextBlock x:Name="PageTitle" Text="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="102,63,0,0" FontSize="24" Foreground="#FFF4F5D9"/>
     <TextBlock Text="{Binding ClockText}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,65,87,0" FontSize="21" Foreground="#FFF4F5D9"/>
     <TextBlock Text="{Binding Gamertag}" Width="245" TextTrimming="CharacterEllipsis" FontSize="23" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,249,27,0">
      <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
     </TextBlock>
     <Canvas x:Name="Home" Width="560" Height="720" HorizontalAlignment="Left">
      <Border Canvas.Left="102" Canvas.Top="109" Width="371" Height="82" BorderThickness="1.5" BorderBrush="#8097884D" CornerRadius="3" Background="#18FFFFFF">
       <Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <Border Width="62" Height="62" BorderThickness="1.5" BorderBrush="#8097884D" Background="#18FFFFFF"><Image Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="Gamerscore" FontSize="22"/><TextBlock Text="Status" FontSize="22"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Dashboard.Profile.Gamerscore}" TextAlignment="Right" FontSize="22"/><TextBlock Text="{Binding Dashboard.Profile.OnlineStatus}" TextAlignment="Right" FontSize="22" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Grid>
      </Border>
      <Border Canvas.Left="102" Canvas.Top="201" Width="371" Height="80" BorderBrush="#70958643" BorderThickness="1" CornerRadius="3">
       <StackPanel Margin="5,0"><TextBlock x:Name="CommunityTitle" Text="Community" FontSize="22"/>
        <UniformGrid Columns="3" Margin="0,0,0,4">
         <Button Style="{StaticResource GuideTool}" Margin="1" Click="MessagesClick" ToolTip="Messages"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE119;" FontFamily="Segoe MDL2 Assets" Margin="0,0,22,0"/><TextBlock Text="{Binding FriendsMessageCountText}"/></StackPanel></Button>
         <Button Style="{StaticResource GuideTool}" Margin="1" Click="FriendsClick" ToolTip="Friends"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,0,22,0"/><TextBlock Text="{Binding FriendsTotalCountText}"/></StackPanel></Button>
         <Button Style="{StaticResource GuideTool}" Margin="1" ToolTip="Recent Players"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Margin="0,0,22,0"/><TextBlock Text="0"/></StackPanel></Button>
        </UniformGrid>
       </StackPanel>
      </Border>
      <Button Canvas.Left="102" Canvas.Top="286" Width="371" Content="Private Chat" Style="{StaticResource GuideRow}"/>
      <Button Canvas.Left="102" Canvas.Top="328" Width="371" Content="Personal Settings" Style="{StaticResource GuideRow}" Click="PersonalSettingsClick"/>
      <Border Canvas.Left="102" Canvas.Top="381" Width="371" Height="92" BorderBrush="#80948846" BorderThickness="1.5" CornerRadius="4">
       <StackPanel Margin="5">
        <UniformGrid Columns="6">
         <Button Command="{Binding Dashboard.PlayPauseMusicCommand}" ToolTip="Play / Pause" FontFamily="Segoe MDL2 Assets"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GuideTool}"><Setter Property="Content" Value="&#xE768;"/><Style.Triggers><DataTrigger Binding="{Binding Dashboard.IsMusicPlaying}" Value="True"><Setter Property="Content" Value="&#xE769;"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
         <Button Style="{StaticResource GuideTool}" Command="{Binding Dashboard.PreviousMusicCommand}" ToolTip="Previous" FontFamily="Segoe MDL2 Assets" Content="&#xE892;"/>
         <Button Style="{StaticResource GuideTool}" Command="{Binding Dashboard.StopMusicCommand}" ToolTip="Stop" FontFamily="Segoe MDL2 Assets" Content="&#xE71A;"/>
         <Button Style="{StaticResource GuideTool}" Command="{Binding Dashboard.NextMusicCommand}" ToolTip="Next" FontFamily="Segoe MDL2 Assets" Content="&#xE893;"/>
         <Button Style="{StaticResource GuideTool}" Command="{Binding Dashboard.ToggleShuffleMusicCommand}" ToolTip="Shuffle" FontFamily="Segoe MDL2 Assets" Content="&#xE8B1;"/>
         <Button Style="{StaticResource GuideTool}" Click="VolumeClick" ToolTip="Volume" FontFamily="Segoe MDL2 Assets" Content="&#xE767;"/>
        </UniformGrid>
        <Button x:Name="SelectMusic" Content="{Binding GuideMediaPlaybackLabel}" Style="{StaticResource GuideRow}" Height="36" Click="MusicClick"/>
       </StackPanel>
      </Border>
      <Button Canvas.Left="102" Canvas.Top="484" Width="371" Height="77" Style="{StaticResource GuideTool}" Background="#FFEEF2DD" Click="DashboardClick">
       <Border Width="346" Height="62">
        <Border.Background>
         <ImageBrush ImageSource="pack://siteoforigin:,,,/Assets/Misc/Xbox_360-Logo.wine.png" Stretch="Uniform" Viewbox="0.1,0.381,0.82,0.26" ViewboxUnits="RelativeToBoundingBox"/>
        </Border.Background>
       </Border>
      </Button>
      <Slider x:Name="Volume" Canvas.Left="102" Canvas.Top="381" Width="310" Height="35" Minimum="0" Maximum="1" Value="{Binding Dashboard.MusicVolume, Mode=TwoWay}" Visibility="Collapsed" ToolTip="Volume"/>
     </Canvas>
     <Canvas x:Name="Page" Width="924" Height="720" HorizontalAlignment="Left" Visibility="Collapsed">
      <ScrollViewer Canvas.Left="102" Canvas.Top="111" Width="366" Height="446" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageMenu"/></ScrollViewer>
      <Border Canvas.Left="482" Canvas.Top="111" Width="342" Height="446" Background="#186E620F" CornerRadius="3">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageDetails" Margin="8"/></ScrollViewer>
      </Border>
     </Canvas>
     <Grid x:Name="Footer" Margin="102,582,86,0" VerticalAlignment="Top" Height="65">
      <StackPanel HorizontalAlignment="Left">
       <StackPanel x:Name="DashboardPrompt" Orientation="Horizontal"><controls:BladePadGlyph Letter="Y" Width="23" Height="23"/><TextBlock Text="Minimize Dashboard" FontSize="18" Foreground="White" Margin="3,0,0,0"/></StackPanel>
       <StackPanel x:Name="SignOutPrompt" Orientation="Horizontal"><controls:BladePadGlyph Letter="X" Width="23" Height="23"/><TextBlock Text="{Binding Dashboard.RunningGameFooterActionText}" FontSize="18" Foreground="White" Margin="3,0,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Back" FontSize="21" Foreground="White" Margin="0,0,3,0"/><controls:BladePadGlyph Letter="B" Width="23" Height="23"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Select" FontSize="21" Foreground="White" Margin="0,0,3,0"/><controls:BladePadGlyph Letter="A" Width="23" Height="23"/></StackPanel></StackPanel>
     </Grid>
    </Grid>
   </Canvas>
  </Viewbox>
 </Grid>
</Window>
