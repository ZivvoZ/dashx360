<Application x:Class="XboxMetroLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:XboxMetroLauncher.ViewModels.Tabs" xmlns:views="clr-namespace:XboxMetroLauncher.Views.Tabs" xmlns:converters="clr-namespace:XboxMetroLauncher.Themes" xmlns:xboxmetrolauncher="clr-namespace:XboxMetroLauncher">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/themes/MetroTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
      <converters:GameCoverStretchConverter x:Key="GameCoverStretchConverter" />
      <converters:GameCoverImageSourceConverter x:Key="GameCoverImageSourceConverter" />
      <converters:GameCoverBrushConverter x:Key="GameCoverBrushConverter" />
      <converters:GameCoverInsetVisibilityConverter x:Key="GameCoverInsetVisibilityConverter" />
      <converters:CropImageSourceConverter x:Key="CropImageSourceConverter" />
      <converters:DashboardTileImageSourceConverter x:Key="DashboardTileImageSourceConverter" />
      <converters:DashboardTileImageBrushConverter x:Key="DashboardTileImageBrushConverter" />
      <converters:DashboardTilePreviewImageSourceConverter x:Key="DashboardTilePreviewImageSourceConverter" />
      <converters:DashboardTileTitleConverter x:Key="DashboardTileTitleConverter" />
      <converters:DashboardTileSecondaryTitleConverter x:Key="DashboardTileSecondaryTitleConverter" />
      <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:BingTabViewModel}}" DataType="{x:Type tabs:BingTabViewModel}">
        <views:BingTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:HomeTabViewModel}}" DataType="{x:Type tabs:HomeTabViewModel}">
        <views:HomeTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:SocialTabViewModel}}" DataType="{x:Type tabs:SocialTabViewModel}">
        <views:SocialTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:GamesTabViewModel}}" DataType="{x:Type tabs:GamesTabViewModel}">
        <views:GamesTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:MediaTabViewModel}}" DataType="{x:Type tabs:MediaTabViewModel}">
        <views:MediaTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:MusicTabViewModel}}" DataType="{x:Type tabs:MusicTabViewModel}">
        <views:MusicTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:AppsTabViewModel}}" DataType="{x:Type tabs:AppsTabViewModel}">
        <views:AppsTabView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type tabs:SettingsTabViewModel}}" DataType="{x:Type tabs:SettingsTabViewModel}">
        <views:SettingsTabView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
