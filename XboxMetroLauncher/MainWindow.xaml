              <TranslateTransform x:Name="MusicPlayerContentTranslate" X="0" />
            </UIElement.RenderTransform>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsMusicVisualizerFullscreen}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
