        <Grid Name="DashboardCustomizerOverlay" Focusable="False" FocusVisualStyle="{x:Null}" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsDashboardCustomizerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
