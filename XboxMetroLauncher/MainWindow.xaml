                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="25" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" />
                        <TextBlock Grid.Column="2" Text="&#xE974;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ShowMusicBrowserMenuArrows, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
