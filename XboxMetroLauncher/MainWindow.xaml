                </FrameworkElement.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Height="47" Focusable="False" Style="{StaticResource MusicBrowserMenuButtonStyle}" IsEnabled="{Binding IsEnabled}" Command="{Binding DataContext.SelectMusicBrowserMenuItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
