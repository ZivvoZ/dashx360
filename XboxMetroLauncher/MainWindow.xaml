        <Grid Name="ThemeMenuOverlay" Focusable="False" FocusVisualStyle="{x:Null}" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsThemeMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
