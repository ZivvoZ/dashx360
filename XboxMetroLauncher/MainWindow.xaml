              <TranslateTransform x:Name="MusicPlayerHeaderTranslate" X="0" />
            </UIElement.RenderTransform>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsMusicVisualizerFullscreen}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
